# FCC Monitor — 環境變數範本
# 複製為 .env 並填入實際值（.env 已被 .gitignore，不會被 commit）
# cp .env.example .env

# --- Spider.cloud (主要爬蟲後端，繞過 Akamai TLS 指紋) ---
# 申請：https://spider.cloud/  (Sign up → Dashboard → API Keys)
# 計費：免費額度有限，付費依 request 計算
SPIDERCLOUD_API_KEY=sk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Browserless.io (備援 headless browser，做 PDF 下載 + 表單提交) ---
# 申請：https://www.browserless.io/  (Sign up → API Token)
# 計費：免費 1000 units/月，付費 $50/月起
BROWSERLESS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram 通知 ---
# Bot Token：在 Telegram 找 @BotFather → /newbot → 拿到 token
# Chat ID：把你的 bot 加入目標 chat → 訪問
#   https://api.telegram.org/bot<TOKEN>/getUpdates → 看 chat.id
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=000000000
